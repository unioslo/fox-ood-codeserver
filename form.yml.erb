---
cluster: "fox"

form:
  - auto_accounts
  - global_fox_alacarte
  - codeserver_version
  - working_dir
  - bc_num_hours
  - ec_mem
  - ec_cpus
  - ec_gpus
  - ec_modulepath
  - ec_modules

attributes:

  ec_mail_on_start:
    label: "Send e-mail when session starts"
    widget: "check_box"
    value: false
    help: |
      <small>Using the e-mail your account is registered to</small>

  codeserver_version:
    label: "code-server version:"
    widget: "select"
    options:
      - [ "4.131.0", "4.131.0" ]
      - [ "4.104.3", "4.104.3" ]
      - [ "4.98.2", "4.98.2" ]

  working_dir:
    widget: "path_selector"
    label: "Working Directory"
    data-target-file-type: dirs  # Valid values are: files, dirs, or both
    readonly: false
    help: "Select your project directory; defaults to $HOME"

  bc_num_hours:
    label: "Runtime (in hours) (required)"
    widget: "number_field"
    required: true
    value: "1"

  auto_accounts:
    label: "Choose the Educloud project to run under:"
    help: |
      <small>If you are unsure, ask the project principal</small>

  ec_mem:
    label: "Memory (GB)"
    widget: "number_field"
    required: true
    value: "2"

  ec_cpus:
    label: "Number of CPUs"
    widget: "number_field"
    required: true
    min: 1
    value: "1"

  ec_gpus:
    label: "Number of GPUs:"
    widget: "number_field"
    value: "0"
    required: true

  ec_modulepath:
          label: "Additional module path"
          help: |
                  <small>Add your own EasyBuild modulepath</small>

  ec_modules:
    label: "Additional modules (optional)"
    value: "R-vscode/4.2.1-foss-2022a"
    help: |
        <small>Space separated list of additional modules to load</br/>
        Run `module avail` for a full list. </small>
